plane pln1 0 0 0  0 0  1  1 0 0
erase pln1

proc MkEdgeAndOffset {} {
    uplevel {
        set curve_name ${is_circ}_${is_open}_${is_forward}
        if {${value} < 0} {
            set curve_name ${curve_name}_neg
        }
        if {${is_circ} == "circ"} {
            circle ${curve_name} $XX $YY 0  30
        } else {
            ellipse ${curve_name} $XX $YY 0  40 30
        }

        set edge_name e_${curve_name}
        if {${is_open} == "open"} {
            mkedge ${edge_name} ${curve_name} 1.2*pi 1.8*pi
        } else {
            mkedge ${edge_name} ${curve_name}
        }
        if {${is_forward} == "reve"} {
            complement ${edge_name}
        }
        vori ${edge_name}

        wire w1 ${edge_name}
        mkface f1 pln1 w1
        set offset_name off_${curve_name}
        openoffset ${offset_name} f1 1 ${value}
        vori ${offset_name}_1
        erase w1 f1

        checkprops ${offset_name}_1 -l ${len}
    }
}

