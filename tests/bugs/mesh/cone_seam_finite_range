set expected [expr {acos(-1.0) * (3.0 + 3.4) * hypot(0.4, 0.4)}]
set filename "$imagedir/cone_seam_finite_range.brep"
foreach slope {0 -1e-14 1e-14} {
  # Change which seam branch is encountered first without changing the wire.
  foreach order {{-6 0 +4 0 +3 0 -4 0} {+4 0 +3 0 -4 0 -6 0} \
                 {+3 0 -4 0 -6 0 +4 0} {-4 0 -6 0 +4 0 +3 0}} {
    set channel [open $filename w]
    puts $channel [subst -nocommands -nobackslashes $data]
    close $channel
    restore $filename result
    file delete $filename

    checkshape result
    incmesh result 0.005 -a 28.64788975654116
    set area [lindex [triarea result] 0]
    checkreal "mesh area (slope $slope, order $order)" $area $expected 0 0.001
  }
}
