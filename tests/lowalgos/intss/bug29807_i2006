puts "========"
puts "0029807: Impossible to cut cone from prism"
puts "========"
puts ""

restore [locate_data_file bug25542_cylinder.brep] b1
restore [locate_data_file bug25542_cone.brep] b2

explode b1 f
explode b2 f
nurbsconvert f1 b1_1
smallview
don f1 b2_1
fit

regexp {Tolerance Reached=+([-0-9.+eE]+)\n+([-0-9.+eE]+)} [bopcurves f1 b2_1 -2d] full Toler NbCurv

# The reported tolerance must bound the surface residuals and meet the required accuracy.
if {$Toler < 0.0 || $Toler > 6.543980576727782e-006} {
  puts "Error: Intersection tolerance exceeds the required accuracy"
}

if {$NbCurv != 2} {
  puts "Error: Please check NbCurves for intersector"
}

if {$NbCurv == 2} {
  mksurface surface1 f1
  mksurface surface2 b2_1
  CheckIntersectionResult surface1 surface2 {c_1 c_2} 1001 $Toler $Toler
  CheckOverlapIntCurves {c_1 c_2}
}

checkview -screenshot -2d -path ${imagedir}/${test_image}_3d.png
smallview -2D-
2dfit
checkview -screenshot -2d -path ${imagedir}/${test_image}_2d.png
