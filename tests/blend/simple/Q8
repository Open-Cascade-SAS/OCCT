restore [locate_data_file CFI_4_j1_ffv.rle] s
tscale s 0 0 0 SCALE
explode s E
# The fillet is refused when its result is not a valid solid.
if { [catch { blend result s 10*SCALE s_12 }] } {
    puts "The blend is refused, the shape is left as it is"
    copy s result
} else {
    checkprops result -s 1.19571e+10
}
