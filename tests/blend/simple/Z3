## ====================================
## Grid    : CFI001
## Test    : Z3
## Comment : Periodic fillet spine closure must not create a C0 surface knot
## ====================================

polyline lower -25 -35 0  25 -35 0  25 35 0  -25 35 0  -25 -35 0
polyline upper -30.2898094213 -40.2898094213 30  \
                30.2898094213 -40.2898094213 30  \
                30.2898094213  40.2898094213 30  \
               -30.2898094213  40.2898094213 30  \
               -30.2898094213 -40.2898094213 30
thrusections loft 1 1 lower upper
checkshape loft

set aVerticalEdges {}
foreach anEdge [explode loft e] {
  bounding $anEdge -save xMin yMin zMin xMax yMax zMax
  if {[dval zMin] < 1.0e-7 && [dval zMax] > 29.9999999} {
    lappend aVerticalEdges $anEdge
  }
}
if {[llength $aVerticalEdges] != 4} {
  puts "Error: expected 4 vertical loft edges, found [llength $aVerticalEdges]"
}

set aVerticalBlend [list blend rounded loft]
foreach anEdge $aVerticalEdges {
  lappend aVerticalBlend 10 $anEdge
}
if {[catch {eval $aVerticalBlend} anError]} {
  puts "Error: vertical fillet failed: $anError"
} else {
  checkshape rounded
}

set aBottomEdges {}
if {[isdraw rounded]} {
  foreach anEdge [explode rounded e] {
    bounding $anEdge -save xMin yMin zMin xMax yMax zMax
    if {abs([dval zMin]) < 1.0e-6 && abs([dval zMax]) < 1.0e-6} {
      lappend aBottomEdges $anEdge
    }
  }
}
if {[llength $aBottomEdges] != 8} {
  puts "Error: expected 8 bottom edges after the vertical fillet, found [llength $aBottomEdges]"
}

# Match the parameters used by the corresponding C++ regression test.
tolblend 1.0e-2 1.0e-4 1.0e-5 1.0e-3
continuityblend C1 1.0e-2

set aLastResult ""
set aSeedIndex 0
foreach anEdge $aBottomEdges {
  incr aSeedIndex
  set aCurrentResult periodic_$aSeedIndex
  if {[catch {blend $aCurrentResult rounded 5 $anEdge R} anError]} {
    puts "Error: bottom fillet failed for seed edge $anEdge: $anError"
    continue
  }

  checkshape $aCurrentResult
  checknbshapes $aCurrentResult -face 18 -edge 40

  set aStats [expshape $aCurrentResult 100 100 C1]
  if {![regexp {Number of BSpline surfaces with continuity less than specified - ([0-9]+)} \
               $aStats aMatch aC0SurfaceCount]} {
    puts "Error: cannot determine the number of C0 BSpline surfaces in $aCurrentResult"
  } elseif {$aC0SurfaceCount != 0} {
    puts "Error: periodic closure created $aC0SurfaceCount C0 BSpline surfaces for seed edge $anEdge"
  }
  set aLastResult $aCurrentResult
}

if {$aSeedIndex != 8} {
  puts "Error: expected 8 periodic bottom fillet cases, processed $aSeedIndex"
}
if {$aLastResult ne ""} {
  renamevar $aLastResult result
}
