#-----------------------------------------------------------------------------
#
# OpenCASCADEConfig.cmake - OpenCASCADE CMake configuration file for external projects.
#
# This file is configured by OpenCASCADE.
#

# The OpenCASCADE version number
set (OpenCASCADE_MAJOR_VERSION       "@OCC_VERSION_MAJOR@")
set (OpenCASCADE_MINOR_VERSION       "@OCC_VERSION_MINOR@")
set (OpenCASCADE_MAINTENANCE_VERSION "@OCC_VERSION_MAINTENANCE@")
set (OpenCASCADE_DEVELOPMENT_VERSION "@OCC_VERSION_DEVELOPMENT@")

if (@OCCT_CONFIG_INSTALL_TREE@)
  @PACKAGE_INIT@
  set (OpenCASCADE_INSTALL_PREFIX "${PACKAGE_PREFIX_DIR}")
  set (OpenCASCADE_BINARY_DIR   "@PACKAGE_INSTALL_DIR_BIN@")
  set (OpenCASCADE_LIBRARY_DIR  "@PACKAGE_INSTALL_DIR_LIB@")
  set (OpenCASCADE_SCRIPT_DIR   "@PACKAGE_INSTALL_DIR_SCRIPT@")
  set (OpenCASCADE_INCLUDE_DIR  "@PACKAGE_INSTALL_DIR_INCLUDE@")
  set (OpenCASCADE_RESOURCE_DIR "@PACKAGE_INSTALL_DIR_RESOURCE@")
else()
  set (OpenCASCADE_INSTALL_PREFIX "@CMAKE_BINARY_DIR@")
  set (OpenCASCADE_SCRIPT_DIR "@CMAKE_BINARY_DIR@")
  set (OpenCASCADE_INCLUDE_DIR "@OCCT_BINARY_DIR@/@INSTALL_DIR_INCLUDE@")
  set (OpenCASCADE_RESOURCE_DIR "@OCCT_ROOT_DIR@/resources")
  string (TOUPPER "${CMAKE_BUILD_TYPE}" _occt_build_config)
  if (@SINGLE_GENERATOR@)
    set (OpenCASCADE_BINARY_DIR  "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@")
    set (OpenCASCADE_LIBRARY_DIR "@CMAKE_ARCHIVE_OUTPUT_DIRECTORY@")
  elseif (_occt_build_config STREQUAL "DEBUG")
    set (OpenCASCADE_BINARY_DIR  "@CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG@")
    set (OpenCASCADE_LIBRARY_DIR "@CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG@")
  elseif (_occt_build_config STREQUAL "RELWITHDEBINFO")
    set (OpenCASCADE_BINARY_DIR  "@CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELWITHDEBINFO@")
    set (OpenCASCADE_LIBRARY_DIR "@CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELWITHDEBINFO@")
  else()
    # Multi-config consumers select configuration-specific paths from imported targets.
    set (OpenCASCADE_BINARY_DIR  "@CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE@")
    set (OpenCASCADE_LIBRARY_DIR "@CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE@")
  endif()
endif()

# The C and C++ flags added by OpenCASCADE to the cmake-configured flags.
set (OpenCASCADE_C_FLAGS      "@CMAKE_C_FLAGS@")
set (OpenCASCADE_CXX_FLAGS    "@CMAKE_CXX_FLAGS@")
@SET_OpenCASCADE_LINKER_FLAGS@

# List of available OpenCASCADE modules.
set (OpenCASCADE_MODULES @OCCT_MODULES_ENABLED@)
@SET_OpenCASCADE_MODULES_TOOLKITS@
# List of available OpenCASCADE libraries.
set (OpenCASCADE_LIBRARIES @OCCT_LIBRARIES@)

# OpenCASCADE global configuration options.
set (OpenCASCADE_COMPILER          "@COMPILER@")
set (OpenCASCADE_BUILD_WITH_DEBUG  @BUILD_WITH_DEBUG@)
set (OpenCASCADE_BUILD_SHARED_LIBS @BUILD_SHARED_LIBS@)
@SET_OpenCASCADE_BUILD_TYPE@

# Use of third-party libraries.
set (OpenCASCADE_WITH_TCL       @USE_TCL@)
set (OpenCASCADE_WITH_FREETYPE  @USE_FREETYPE@)
set (OpenCASCADE_WITH_FREEIMAGE @USE_FREEIMAGE@)
set (OpenCASCADE_WITH_TBB       @USE_TBB@)
set (OpenCASCADE_WITH_VTK       @USE_VTK@)
set (OpenCASCADE_WITH_FFMPEG    @USE_FFMPEG@)
set (OpenCASCADE_WITH_GLES2     @USE_GLES2@)
@SET_OpenCASCADE_WITH_D3D@
@SET_OpenCASCADE_WITH_GLX@

# Validate each request before importing targets or applying build flags.
set (OpenCASCADE_FOUND TRUE)
unset (OpenCASCADE_NOTFOUND_MESSAGE)
set (_occt_requested_modules)
if (OpenCASCADE_FIND_COMPONENTS)
  foreach (_occt_component IN LISTS OpenCASCADE_FIND_COMPONENTS)
    list (FIND OpenCASCADE_MODULES "${_occt_component}" _occt_component_index)
    if (_occt_component_index EQUAL -1)
      set (OpenCASCADE_${_occt_component}_FOUND FALSE)
      if (OpenCASCADE_FIND_REQUIRED_${_occt_component})
        set (OpenCASCADE_FOUND FALSE)
        string (APPEND OpenCASCADE_NOTFOUND_MESSAGE "Unsupported required component: ${_occt_component}. ")
      endif()
    else()
      set (OpenCASCADE_${_occt_component}_FOUND TRUE)
      list (APPEND _occt_requested_modules "${_occt_component}")
    endif()
  endforeach()
else()
  set (_occt_requested_modules ${OpenCASCADE_MODULES})
endif()
if (NOT OpenCASCADE_FOUND)
  return()
endif()

if (NOT OpenCASCADE_ALREADY_INCLUDED)
  set (OpenCASCADE_ALREADY_INCLUDED 1)
  file (GLOB _occt_config_files "${CMAKE_CURRENT_LIST_DIR}/OpenCASCADECompileDefinitionsAndFlags-*.cmake")
  foreach (_occt_file IN LISTS _occt_config_files)
    include ("${_occt_file}")
  endforeach()
endif()

if (@OCCT_CONFIG_INSTALL_TREE@)
@SET_OpenCASCADE_MODULE_DEPENDENCIES@
  set (_occt_import_modules ${_occt_requested_modules})
  foreach (_occt_module IN LISTS _occt_requested_modules)
    list (APPEND _occt_import_modules ${_occt_dependencies_${_occt_module}})
  endforeach()
  foreach (_occt_module IN LISTS OpenCASCADE_MODULES)
    list (FIND _occt_import_modules "${_occt_module}" _occt_module_index)
    if (NOT _occt_module_index EQUAL -1)
      include ("${CMAKE_CURRENT_LIST_DIR}/OpenCASCADE${_occt_module}Targets.cmake")
    endif()
  endforeach()
elseif (_occt_requested_modules)
  include ("${CMAKE_CURRENT_LIST_DIR}/OpenCASCADETargets.cmake")
endif()
