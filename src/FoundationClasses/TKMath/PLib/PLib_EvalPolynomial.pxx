#ifndef _PLib_EvalPolynomial_HeaderFile
#define _PLib_EvalPolynomial_HeaderFile

#include <stddef.h>

namespace
{
//==================================================================================================

// Horner evaluation with highest-order coefficient rows first.
// Each borrowed row and the result contain at least theDimension elements.
// The result must not overwrite coefficient rows that are still needed.
template <class Real, class CoefficientAccessor>
void evalPolynomialValue(const size_t               theDegree,
                         const size_t               theDimension,
                         const Real&                theParameter,
                         const CoefficientAccessor& theCoefficient,
                         Real*                      theResult)
{
  const auto& aFirst = theCoefficient(0);
  for (size_t aCoordinate = 0; aCoordinate < theDimension; ++aCoordinate)
  {
    theResult[aCoordinate] = aFirst[aCoordinate];
  }
  for (size_t aStep = 1; aStep <= theDegree; ++aStep)
  {
    const auto& aCoefficient = theCoefficient(aStep);
    for (size_t aCoordinate = 0; aCoordinate < theDimension; ++aCoordinate)
    {
      theResult[aCoordinate] = theResult[aCoordinate] * theParameter + aCoefficient[aCoordinate];
    }
  }
}
} // namespace

#endif // _PLib_EvalPolynomial_HeaderFile
