#include <TCollection_UtfStringTool.hxx>

#include <cstring>

//=================================================================================================

template <typename Type>
template <typename TypeFrom>
bool TCollection_UtfString<Type>::FromUnicode(const TypeFrom* theString, size_t theCodeUnits)
{
  if (theString == nullptr && theCodeUnits != 0)
  {
    return false;
  }
  if (theCodeUnits == 0)
  {
    Clear();
    return true;
  }

  TCollection_UtfIterator<TypeFrom> anIter(theString, theCodeUnits);
  StorageType                       aResult;
  size_t                            aLength       = 0;
  size_t                            anOutputUnits = 0;
  for (; anIter.More(); ++anIter)
  {
    if (!anIter.IsValid())
    {
      return false;
    }
    if constexpr (!std::is_same_v<Type, TypeFrom>)
    {
      const size_t aCount = anIter.template AdvanceBytesUtf<Type>() / sizeof(Type);
      if (aCount > aResult.max_size() - anOutputUnits)
      {
        throw Standard_RangeError("Converted Unicode string is too large");
      }
      anOutputUnits += aCount;
    }
    ++aLength;
  }
  if constexpr (std::is_same_v<Type, TypeFrom>)
  {
    // Validate before replacing storage, including when input aliases this string.
    aResult.assign(theString, theCodeUnits);
  }
  else if (sizeof(TypeFrom) == 1 && aLength == theCodeUnits)
  {
    // Valid UTF-8 with one code unit per scalar is ASCII, including embedded nulls.
    aResult.resize(theCodeUnits);
    for (size_t anIndex = 0; anIndex < theCodeUnits; ++anIndex)
    {
      aResult[anIndex] = static_cast<Type>(theString[anIndex]);
    }
  }
  else
  {
    aResult.resize(anOutputUnits);
    Type*  aWrite     = aResult.data();
    size_t aRemaining = anOutputUnits;
    anIter.Init(theString, theCodeUnits);
    for (; anIter.More(); ++anIter)
    {
      Type* anEnd = anIter.GetUtf(aWrite, aRemaining);
      aRemaining -= static_cast<size_t>(anEnd - aWrite);
      aWrite = anEnd;
    }
  }
  myString.swap(aResult);
  myLength = aLength;
  return true;
}

//=================================================================================================

template <typename Type>
char32_t TCollection_UtfString<Type>::GetChar(size_t theIndex) const
{
  if (theIndex >= myLength)
  {
    throw Standard_OutOfRange("Unicode scalar index");
  }
  auto anIter = Iterator();
  while (anIter.Index() != theIndex)
  {
    ++anIter;
  }
  return *anIter;
}

//=================================================================================================

template <typename Type>
auto TCollection_UtfString<Type>::GetCharView(size_t theIndex) const -> std::optional<ViewType>
{
  if (theIndex >= myLength)
  {
    return std::nullopt;
  }
  auto anIter = Iterator();
  while (anIter.Index() != theIndex)
  {
    ++anIter;
  }
  return ViewType(anIter.BufferHere(), anIter.CodeUnits());
}

//=================================================================================================

template <typename Type>
TCollection_UtfString<Type> TCollection_UtfString<Type>::SubString(size_t theStart,
                                                                   size_t theEnd) const
{
  if (theStart > theEnd || theEnd > myLength)
  {
    throw Standard_OutOfRange("Unicode substring range");
  }
  TCollection_UtfString aResult;
  if (theStart == theEnd)
  {
    return aResult;
  }
  auto anIter = Iterator();
  while (anIter.Index() < theStart)
  {
    ++anIter;
  }
  const Type* aFirst = anIter.BufferHere();
  while (anIter.Index() < theEnd)
  {
    ++anIter;
  }
  aResult.myString.assign(aFirst, static_cast<size_t>(anIter.BufferHere() - aFirst));
  aResult.myLength = theEnd - theStart;
  return aResult;
}

//=================================================================================================

template <typename Type>
bool TCollection_UtfString<Type>::FromLocale(std::string_view theString)
{
  const auto aWide = TCollection_UtfStringTool::FromLocale(theString);
  return aWide && FromUnicode(aWide->data(), aWide->size());
}

//=================================================================================================

template <typename Type>
bool TCollection_UtfString<Type>::ToLocale(char* theBuffer, size_t theCapacity) const
{
  const auto aWide  = ToUtfWide();
  const auto aBytes = TCollection_UtfStringTool::ToLocale(aWide.View());
  if (!aBytes || theBuffer == nullptr || aBytes->size() >= theCapacity)
  {
    return false;
  }
  std::memcpy(theBuffer, aBytes->data(), aBytes->size());
  theBuffer[aBytes->size()] = '\0';
  return true;
}
