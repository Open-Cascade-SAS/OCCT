#ifndef _GeomFill_GordonUtils_HeaderFile
#define _GeomFill_GordonUtils_HeaderFile

namespace GeomFill_GordonUtils
{

//! Returns a scale-aware tolerance for comparing parameters in the given interval.
double parameterTolerance(const double theFirst, const double theLast)
{
  const double aRange = std::max(std::abs(theLast - theFirst), 1.0);
  return Precision::PIntersection(aRange);
}

//! Returns a parameter tolerance for sampled reparametrization decisions.
double approximationParameterTolerance(const double theFirst,
                                       const double theLast,
                                       const double theTolerance)
{
  const double aRange = std::max(std::abs(theLast - theFirst), 1.0);
  return Precision::Parametric(std::max(theTolerance, Precision::Approximation())) * aRange;
}

//! Returns the degree used by auxiliary reparametrization curves.
int reparametrizationDegree()
{
  return Geom_BSplineCurve::MaxDegree() < 3 ? Geom_BSplineCurve::MaxDegree() : 3;
}

//! Initializes adaptor arrays for fast repeated curve evaluations.
void loadCurveAdaptors(const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theCurves,
                       NCollection_Array1<GeomAdaptor_Curve>&                    theAdaptors)
{
  for (size_t aCurveIdx = 0; aCurveIdx < theCurves.Size(); ++aCurveIdx)
  {
    theAdaptors.ChangeAt(aCurveIdx).Load(theCurves.At(aCurveIdx));
  }
}

//! Creates a parameter grid with uniform spacing that captures exact break locations.
//! Break parameters (intersections, kinks) are snapped to nearby grid points when
//! possible, or inserted as additional points otherwise.
//! @param[in] theUMin      start of parameter range
//! @param[in] theUMax      end of parameter range
//! @param[in] theNbValues  desired number of uniform grid points
//! @param[in] theBreaks    break parameters to capture exactly
//! @return sorted, deduplicated parameter array
NCollection_LinearVector<double> linspaceWithBreaks(double                            theUMin,
                                                    double                            theUMax,
                                                    size_t                            theNbValues,
                                                    const NCollection_Array1<double>& theBreaks)
{
  // Create uniform grid.
  const double                     aDu = (theUMax - theUMin) / static_cast<double>(theNbValues - 1);
  NCollection_LinearVector<double> aResult;
  for (size_t aValueIdx = 0; aValueIdx < theNbValues; ++aValueIdx)
  {
    aResult.Append(theUMin + static_cast<double>(aValueIdx) * aDu);
  }

  for (size_t aBreakIdx = 0; aBreakIdx < theBreaks.Size(); ++aBreakIdx)
  {
    double aBreak = theBreaks.At(aBreakIdx);
    if (aBreak > theUMin && aBreak < theUMax)
    {
      aResult.Append(aBreak);
    }
  }

  // Sort and remove duplicates.
  std::sort(aResult.begin(), aResult.end());

  // Compact duplicates in-place.
  size_t       aWriteIdx = 0;
  const double aParamTol = parameterTolerance(theUMin, theUMax);
  for (size_t aUniqueIdx = 1; aUniqueIdx < aResult.Size(); ++aUniqueIdx)
  {
    if (std::abs(aResult.Value(aUniqueIdx) - aResult.Value(aWriteIdx)) > aParamTol)
    {
      ++aWriteIdx;
      aResult.ChangeValue(aWriteIdx) = aResult.Value(aUniqueIdx);
    }
  }
  // Trim to unique count.
  const size_t aNbUnique = aWriteIdx + 1;
  while (aResult.Size() > aNbUnique)
  {
    aResult.EraseLast();
  }

  return aResult;
}

//! Appends a break parameter when it lies strictly inside the segment.
//! @param[in,out] theBreaks break list
//! @param[in]     theParam  candidate break parameter
//! @param[in]     theFirst  segment first parameter
//! @param[in]     theLast   segment last parameter
void appendInteriorBreak(NCollection_LinearVector<double>& theBreaks,
                         double                            theParam,
                         double                            theFirst,
                         double                            theLast)
{
  const double aParamTol = parameterTolerance(theFirst, theLast);
  if (theParam > theFirst + aParamTol && theParam < theLast - aParamTol)
  {
    theBreaks.Append(theParam);
  }
}

//! Samples the original curve through a reparametrization function and approximates one segment.
//! @param[in] theReparamFunc 2D B-spline: newParam -> (oldParam, 0)
//! @param[in] theAdaptor     original curve adaptor
//! @param[in] theFirst       first new parameter
//! @param[in] theLast        last new parameter
//! @param[in] theNbSamples   desired sample count
//! @param[in] theBreaks      interior parameters to sample exactly
//! @param[in] theTolerance   approximation tolerance
//! @return reparametrized B-spline segment, or null on failure
occ::handle<Geom_BSplineCurve> approximateReparamSegment(
  const occ::handle<Geom2d_BSplineCurve>& theReparamFunc,
  const GeomAdaptor_Curve&                theAdaptor,
  double                                  theFirst,
  double                                  theLast,
  size_t                                  theNbSamples,
  const NCollection_LinearVector<double>& theBreaks,
  double                                  theTolerance)
{
  const double aParamTol = parameterTolerance(theFirst, theLast);
  if (theLast <= theFirst + aParamTol)
  {
    return nullptr;
  }

  NCollection_LinearVector<double> aSampleParams;
  if (!theBreaks.IsEmpty())
  {
    NCollection_Array1<double> aBreaks(1, static_cast<int>(theBreaks.Size()));
    for (size_t aBreakIdx = 0; aBreakIdx < theBreaks.Size(); ++aBreakIdx)
    {
      aBreaks(static_cast<int>(aBreakIdx) + 1) = theBreaks.Value(aBreakIdx);
    }
    aSampleParams = linspaceWithBreaks(theFirst, theLast, theNbSamples, aBreaks);
  }
  else
  {
    for (size_t aSampleIdx = 0; aSampleIdx < theNbSamples; ++aSampleIdx)
    {
      const double aT = static_cast<double>(aSampleIdx) / static_cast<double>(theNbSamples - 1);
      aSampleParams.Append(theFirst + (theLast - theFirst) * aT);
    }
  }

  const int aNbActual = static_cast<int>(aSampleParams.Size());
  if (aNbActual < 2)
  {
    return nullptr;
  }

  NCollection_Array1<gp_Pnt> aSampledPnts(1, aNbActual);
  NCollection_Array1<double> aSampledParams(1, aNbActual);
  for (int aSampleIdx = 0; aSampleIdx < aNbActual; ++aSampleIdx)
  {
    const double aNewParam  = aSampleParams.Value(static_cast<size_t>(aSampleIdx));
    double       anOldParam = theReparamFunc->Value(aNewParam).X();
    anOldParam =
      std::max(theAdaptor.FirstParameter(), std::min(theAdaptor.LastParameter(), anOldParam));

    aSampledPnts(aSampleIdx + 1)   = theAdaptor.EvalD0(anOldParam);
    aSampledParams(aSampleIdx + 1) = aNewParam;
  }

  math_Vector aParams(1, aNbActual);
  aParams(1)         = 0.0;
  aParams(aNbActual) = 1.0;
  const double aSpan = theLast - theFirst;
  for (int aParamIdx = 2; aParamIdx < aNbActual; ++aParamIdx)
  {
    aParams(aParamIdx) = (aSampledParams(aParamIdx) - theFirst) / aSpan;
  }

  occ::handle<NCollection_HArray1<gp_Pnt>> aPnts = new NCollection_HArray1<gp_Pnt>(1, aNbActual);
  occ::handle<NCollection_HArray1<double>> aPars = new NCollection_HArray1<double>(1, aNbActual);
  for (int aPointIdx = 1; aPointIdx <= aNbActual; ++aPointIdx)
  {
    aPnts->SetValue(aPointIdx, aSampledPnts(aPointIdx));
    aPars->SetValue(aPointIdx, aParams(aPointIdx));
  }

  GeomAPI_Interpolate anInterp(aPnts, aPars, false, std::max(theTolerance, Precision::Confusion()));
  anInterp.Perform();
  if (!anInterp.IsDone())
  {
    return nullptr;
  }

  occ::handle<Geom_BSplineCurve> aCurve = anInterp.Curve();
  NCollection_Array1<double>     aKnots(aCurve->Knots());
  BSplCLib::Reparametrize(theFirst, theLast, aKnots);
  aCurve->SetKnots(aKnots);
  return aCurve;
}

//! Reparametrizes a single B-spline curve using interpolation-based sampling.
//! 1. Build 2D interpolation: newParam -> oldParam
//! 2. Use intersection parameters as exact sampling breaks
//! 3. Interpolate sampled points in the target parameter space
//! @param[in,out] theCurve     B-spline curve to reparametrize (replaced on success)
//! @param[in]     theOldParams old intersection parameters on the curve
//! @param[in]     theNewParams target intersection parameters in [0,1]
//! @param[in]     theTolerance approximation tolerance
//! @return true if reparametrization succeeded
bool reparamCurve(occ::handle<Geom_BSplineCurve>&   theCurve,
                  const NCollection_Array1<double>& theOldParams,
                  const NCollection_Array1<double>& theNewParams,
                  double                            theTolerance)
{
  NCollection_LinearVector<double> anOldSeq;
  NCollection_LinearVector<double> aNewSeq;
  const double                     anOriginalParamTol =
    parameterTolerance(theCurve->FirstParameter(), theCurve->LastParameter());
  const double aTargetParamTol = parameterTolerance(0.0, 1.0);

  // Start of curve.
  anOldSeq.Append(theCurve->FirstParameter());
  aNewSeq.Append(0.0);

  // Interior intersection points.
  for (size_t aParamIdx = 0; aParamIdx < theOldParams.Size(); ++aParamIdx)
  {
    double anOld = theOldParams.At(aParamIdx);
    double aNew  = theNewParams.At(aParamIdx);

    if (!anOldSeq.IsEmpty()
        && (std::abs(anOld - anOldSeq.Last()) < anOriginalParamTol
            || std::abs(aNew - aNewSeq.Last()) < aTargetParamTol))
    {
      continue;
    }
    if (std::abs(anOld - theCurve->LastParameter()) < anOriginalParamTol
        || std::abs(aNew - 1.0) < aTargetParamTol)
    {
      continue;
    }

    anOldSeq.Append(anOld);
    aNewSeq.Append(aNew);
  }

  // End of curve.
  if (anOldSeq.Size() < 2
      || std::abs(anOldSeq.Last() - theCurve->LastParameter()) > anOriginalParamTol)
  {
    anOldSeq.Append(theCurve->LastParameter());
    aNewSeq.Append(1.0);
  }

  if (anOldSeq.Size() < 2)
  {
    return true;
  }

  // Build 2D interpolation: newParam -> (oldParam, 0).
  const int                                  aNbPts = static_cast<int>(anOldSeq.Size());
  occ::handle<NCollection_HArray1<gp_Pnt2d>> aOldPnts2d =
    new NCollection_HArray1<gp_Pnt2d>(1, aNbPts);
  occ::handle<NCollection_HArray1<double>> aNewParamsH = new NCollection_HArray1<double>(1, aNbPts);
  for (size_t aPointIdx = 0; aPointIdx < anOldSeq.Size(); ++aPointIdx)
  {
    aOldPnts2d->SetValue(static_cast<int>(aPointIdx) + 1, gp_Pnt2d(anOldSeq.Value(aPointIdx), 0.0));
    aNewParamsH->SetValue(static_cast<int>(aPointIdx) + 1, aNewSeq.Value(aPointIdx));
  }

  Geom2dAPI_Interpolate anInterp2d(aOldPnts2d, aNewParamsH, false, Precision::PConfusion());
  anInterp2d.Perform();
  if (!anInterp2d.IsDone())
  {
    return false;
  }

  occ::handle<Geom2d_BSplineCurve> aReparamFunc = anInterp2d.Curve();
  GeomAdaptor_Curve                aCurveAdaptor(theCurve);

  // Pre-compute sizes for break arrays.
  const int aNbInteriorParams = std::max(0, theNewParams.Upper() - theNewParams.Lower() - 1);
  const int aNbBreaks         = aNbInteriorParams;

  // Determine sample count from interpolation constraints.
  const int aMaxCp         = theCurve->NbPoles();
  const int aReparamDegree = reparametrizationDegree();
  const int aDegreeSpan    = aReparamDegree + 1;
  const size_t aNbSamples =
    static_cast<size_t>(std::max({aMaxCp * aDegreeSpan,
                                  aDegreeSpan * aDegreeSpan * std::max(1, aReparamDegree - 1),
                                  aNbBreaks + aDegreeSpan}));

  NCollection_LinearVector<double> aBreaks;
  for (int aNewParamIdx = theNewParams.Lower() + 1; aNewParamIdx < theNewParams.Upper();
       ++aNewParamIdx)
  {
    appendInteriorBreak(aBreaks, theNewParams(aNewParamIdx), 0.0, 1.0);
  }

  theCurve = approximateReparamSegment(aReparamFunc,
                                       aCurveAdaptor,
                                       0.0,
                                       1.0,
                                       aNbSamples,
                                       aBreaks,
                                       theTolerance);
  return !theCurve.IsNull();
}

//! Validates input curves and normalizes all accepted knot domains to [0,1].
//! @return false if any curve is null, rational, or periodic
bool normalizeCurveDomains(NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
                           NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides)
{
  auto normalizeFamily = [](NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theCurves) -> bool {
    for (size_t aCurveIdx = 0; aCurveIdx < theCurves.Size(); ++aCurveIdx)
    {
      occ::handle<Geom_BSplineCurve>& aCurve = theCurves.ChangeAt(aCurveIdx);
      if (aCurve.IsNull() || aCurve->IsRational() || aCurve->IsPeriodic())
      {
        return false;
      }

      NCollection_Array1<double> aKnots(aCurve->Knots());
      BSplCLib::Reparametrize(0.0, 1.0, aKnots);
      aCurve->SetKnots(aKnots);
    }
    return true;
  };

  return normalizeFamily(theProfiles) && normalizeFamily(theGuides);
}

//=================================================================================================

//! Computes all profile/guide intersection parameters.
//! The nearest extremum under tolerance is used, with a boundary nearest-point fallback.
//! @return false if any profile/guide pair has no intersection within tolerance
bool locateIntersections(const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
                         const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides,
                         NCollection_Array2<double>&                               theProfileParams,
                         NCollection_Array2<double>&                               theGuideParams,
                         const double                                              theTolerance,
                         const bool                                                theToUseParallel)
{
  const int aNbProf  = theProfiles.Length();
  const int aNbGuid  = theGuides.Length();
  const int aNbTotal = aNbProf * aNbGuid;

  auto processPair = [&](const int theIdx) -> bool {
    const int aProfileIdx = theIdx / aNbGuid + 1;
    const int aGuideIdx   = theIdx % aNbGuid + 1;

    GeomAPI_ExtremaCurveCurve anExtrema(theProfiles(aProfileIdx), theGuides(aGuideIdx));

    bool   isFound       = false;
    double aBestDistance = RealLast();
    double aProfileParam = 0.0;
    double aGuideParam   = 0.0;

    for (int anExtIdx = 1; anExtIdx <= anExtrema.NbExtrema(); ++anExtIdx)
    {
      const double aDistance = anExtrema.Distance(anExtIdx);
      if (aDistance < theTolerance && aDistance < aBestDistance)
      {
        aBestDistance = aDistance;
        anExtrema.Parameters(anExtIdx, aProfileParam, aGuideParam);
        isFound = true;
      }
    }

    if (!isFound)
    {
      gp_Pnt aPointOnProfile, aPointOnGuide;
      if (anExtrema.TotalNearestPoints(aPointOnProfile, aPointOnGuide)
          && aPointOnProfile.Distance(aPointOnGuide) < theTolerance)
      {
        isFound = anExtrema.TotalLowerDistanceParameters(aProfileParam, aGuideParam);
      }
    }

    if (!isFound)
    {
      return false;
    }

    theProfileParams(aProfileIdx, aGuideIdx) = aProfileParam;
    theGuideParams(aProfileIdx, aGuideIdx)   = aGuideParam;
    return true;
  };

  std::atomic<bool> isOk{true};
  OSD_Parallel::For(
    0,
    aNbTotal,
    [&](const int theIdx) {
      if (isOk.load(std::memory_order_relaxed) && !processPair(theIdx))
      {
        isOk.store(false, std::memory_order_relaxed);
      }
    },
    !theToUseParallel);

  return isOk.load();
}

//=================================================================================================

//! Snaps near-boundary intersection parameters to exact curve boundary parameters.
void snapBoundaryParameters(const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
                            const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides,
                            NCollection_Array2<double>& theProfileParams,
                            NCollection_Array2<double>& theGuideParams,
                            const double                theTolerance)
{
  const size_t aNbProf = theProfiles.Size();
  const size_t aNbGuid = theGuides.Size();

  for (size_t aProfileIdx = 0; aProfileIdx < aNbProf; ++aProfileIdx)
  {
    const double aFirst    = theProfiles.At(aProfileIdx)->FirstParameter();
    const double aLast     = theProfiles.At(aProfileIdx)->LastParameter();
    const double aParamTol = approximationParameterTolerance(aFirst, aLast, theTolerance);

    for (size_t aGuideIdx = 0; aGuideIdx < aNbGuid; ++aGuideIdx)
    {
      double& aParam = theProfileParams.ChangeAt(aProfileIdx, aGuideIdx);
      if (std::abs(aParam - aFirst) < aParamTol)
      {
        aParam = aFirst;
      }
      else if (std::abs(aParam - aLast) < aParamTol)
      {
        aParam = aLast;
      }
    }
  }

  for (size_t aGuideIdx = 0; aGuideIdx < aNbGuid; ++aGuideIdx)
  {
    const double aFirst    = theGuides.At(aGuideIdx)->FirstParameter();
    const double aLast     = theGuides.At(aGuideIdx)->LastParameter();
    const double aParamTol = approximationParameterTolerance(aFirst, aLast, theTolerance);

    for (size_t aProfileIdx = 0; aProfileIdx < aNbProf; ++aProfileIdx)
    {
      double& aParam = theGuideParams.ChangeAt(aProfileIdx, aGuideIdx);
      if (std::abs(aParam - aFirst) < aParamTol)
      {
        aParam = aFirst;
      }
      else if (std::abs(aParam - aLast) < aParamTol)
      {
        aParam = aLast;
      }
    }
  }
}

//=================================================================================================

//! Detects closed U/V seams by checking boundary curves and boundary intersection points.
void markClosedSeams(const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
                     const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides,
                     const NCollection_Array2<double>&                         theProfileParams,
                     const NCollection_Array2<double>&                         theGuideParams,
                     const double                                              theTolerance,
                     bool&                                                     theIsUClosed,
                     bool&                                                     theIsVClosed)
{
  const int                             aNbProf   = theProfiles.Length();
  const int                             aNbGuid   = theGuides.Length();
  const double                          aCloseTol = std::max(theTolerance, Precision::Confusion());
  NCollection_Array1<GeomAdaptor_Curve> aProfileAdaptors(theProfiles.Lower(), theProfiles.Upper());
  NCollection_Array1<GeomAdaptor_Curve> aGuideAdaptors(theGuides.Lower(), theGuides.Upper());
  loadCurveAdaptors(theProfiles, aProfileAdaptors);
  loadCurveAdaptors(theGuides, aGuideAdaptors);

  {
    gp_Pnt aGuidFirstStart = aGuideAdaptors(1).EvalD0(aGuideAdaptors(1).FirstParameter());
    gp_Pnt aGuidFirstEnd   = aGuideAdaptors(1).EvalD0(aGuideAdaptors(1).LastParameter());
    gp_Pnt aGuidLastStart =
      aGuideAdaptors(aNbGuid).EvalD0(aGuideAdaptors(aNbGuid).FirstParameter());
    gp_Pnt aGuidLastEnd = aGuideAdaptors(aNbGuid).EvalD0(aGuideAdaptors(aNbGuid).LastParameter());

    bool isGuidesEqual = aGuidFirstStart.IsEqual(aGuidLastStart, aCloseTol)
                         && aGuidFirstEnd.IsEqual(aGuidLastEnd, aCloseTol);

    bool isGridClosed = true;
    for (int aProfileIdx = 1; aProfileIdx <= aNbProf && isGridClosed; ++aProfileIdx)
    {
      gp_Pnt aP1   = aProfileAdaptors(aProfileIdx).EvalD0(theProfileParams(aProfileIdx, 1));
      gp_Pnt aP2   = aProfileAdaptors(aProfileIdx).EvalD0(theProfileParams(aProfileIdx, aNbGuid));
      isGridClosed = aP1.IsEqual(aP2, aCloseTol);
    }

    theIsUClosed = isGuidesEqual && isGridClosed;
  }

  {
    gp_Pnt aProfFirstStart = aProfileAdaptors(1).EvalD0(aProfileAdaptors(1).FirstParameter());
    gp_Pnt aProfFirstEnd   = aProfileAdaptors(1).EvalD0(aProfileAdaptors(1).LastParameter());
    gp_Pnt aProfLastStart =
      aProfileAdaptors(aNbProf).EvalD0(aProfileAdaptors(aNbProf).FirstParameter());
    gp_Pnt aProfLastEnd =
      aProfileAdaptors(aNbProf).EvalD0(aProfileAdaptors(aNbProf).LastParameter());

    bool isProfilesEqual = aProfFirstStart.IsEqual(aProfLastStart, aCloseTol)
                           && aProfFirstEnd.IsEqual(aProfLastEnd, aCloseTol);

    bool isGridClosed = true;
    for (int aGuideIdx = 1; aGuideIdx <= aNbGuid && isGridClosed; ++aGuideIdx)
    {
      gp_Pnt aP1   = aGuideAdaptors(aGuideIdx).EvalD0(theGuideParams(1, aGuideIdx));
      gp_Pnt aP2   = aGuideAdaptors(aGuideIdx).EvalD0(theGuideParams(aNbProf, aGuideIdx));
      isGridClosed = aP1.IsEqual(aP2, aCloseTol);
    }

    theIsVClosed = isProfilesEqual && isGridClosed;
  }
}

//=================================================================================================

//! Checks that every stored profile/guide parameter pair evaluates to the same 3D point.
//! @return false if any intersection pair is farther than tolerance
bool isIntersectionGridConsistent(
  const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
  const NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides,
  const NCollection_Array2<double>&                         theProfileParams,
  const NCollection_Array2<double>&                         theGuideParams,
  const double                                              theTolerance)
{
  const size_t                          aNbProf = theProfiles.Size();
  const size_t                          aNbGuid = theGuides.Size();
  NCollection_Array1<GeomAdaptor_Curve> aProfileAdaptors(theProfiles.Lower(), theProfiles.Upper());
  NCollection_Array1<GeomAdaptor_Curve> aGuideAdaptors(theGuides.Lower(), theGuides.Upper());
  loadCurveAdaptors(theProfiles, aProfileAdaptors);
  loadCurveAdaptors(theGuides, aGuideAdaptors);

  const double aCheckTol = std::max(theTolerance, Precision::Confusion());

  for (size_t aProfileIdx = 0; aProfileIdx < aNbProf; ++aProfileIdx)
  {
    for (size_t aGuideIdx = 0; aGuideIdx < aNbGuid; ++aGuideIdx)
    {
      gp_Pnt aProfPt =
        aProfileAdaptors.At(aProfileIdx).EvalD0(theProfileParams.At(aProfileIdx, aGuideIdx));
      gp_Pnt aGuidPt =
        aGuideAdaptors.At(aGuideIdx).EvalD0(theGuideParams.At(aProfileIdx, aGuideIdx));

      if (aProfPt.Distance(aGuidPt) > aCheckTol)
      {
        return false;
      }
    }
  }

  return true;
}

//=================================================================================================

//! Reorders and orients curves using average intersection parameters in the opposite family.
//! @return false if either curve family is too small to define a Gordon network
bool arrangeNetwork(NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
                    NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides,
                    NCollection_Array2<double>&                         theProfileParams,
                    NCollection_Array2<double>&                         theGuideParams)
{
  const int aNbProf = theProfiles.Length();
  const int aNbGuid = theGuides.Length();

  if (aNbProf < 2 || aNbGuid < 2)
  {
    return false;
  }

  auto swapProfiles = [&](int aProfileIdx1, int aProfileIdx2) {
    if (aProfileIdx1 == aProfileIdx2)
    {
      return;
    }
    std::swap(theProfiles(aProfileIdx1), theProfiles(aProfileIdx2));
    for (int aGuideIdx = 1; aGuideIdx <= aNbGuid; ++aGuideIdx)
    {
      std::swap(theProfileParams(aProfileIdx1, aGuideIdx),
                theProfileParams(aProfileIdx2, aGuideIdx));
      std::swap(theGuideParams(aProfileIdx1, aGuideIdx), theGuideParams(aProfileIdx2, aGuideIdx));
    }
  };

  auto swapGuides = [&](int aGuideIdx1, int aGuideIdx2) {
    if (aGuideIdx1 == aGuideIdx2)
    {
      return;
    }
    std::swap(theGuides(aGuideIdx1), theGuides(aGuideIdx2));
    for (int aProfileIdx = 1; aProfileIdx <= aNbProf; ++aProfileIdx)
    {
      std::swap(theProfileParams(aProfileIdx, aGuideIdx1),
                theProfileParams(aProfileIdx, aGuideIdx2));
      std::swap(theGuideParams(aProfileIdx, aGuideIdx1), theGuideParams(aProfileIdx, aGuideIdx2));
    }
  };

  auto reverseProfile = [&](int aProfileIdx) {
    const double aFirst = theProfiles(aProfileIdx)->FirstParameter();
    const double aLast  = theProfiles(aProfileIdx)->LastParameter();
    for (int aGuideIdx = 1; aGuideIdx <= aNbGuid; ++aGuideIdx)
    {
      theProfileParams(aProfileIdx, aGuideIdx) =
        -theProfileParams(aProfileIdx, aGuideIdx) + aFirst + aLast;
    }
    theProfiles(aProfileIdx)->Reverse();
  };

  auto reverseGuide = [&](int aGuideIdx) {
    const double aFirst = theGuides(aGuideIdx)->FirstParameter();
    const double aLast  = theGuides(aGuideIdx)->LastParameter();
    for (int aProfileIdx = 1; aProfileIdx <= aNbProf; ++aProfileIdx)
    {
      theGuideParams(aProfileIdx, aGuideIdx) =
        -theGuideParams(aProfileIdx, aGuideIdx) + aFirst + aLast;
    }
    theGuides(aGuideIdx)->Reverse();
  };

  auto profileRank = [&](const int theProfileIdx) {
    double aSum = 0.0;
    for (int aGuideIdx = 1; aGuideIdx <= aNbGuid; ++aGuideIdx)
    {
      aSum += theGuideParams(theProfileIdx, aGuideIdx);
    }
    return aSum / static_cast<double>(aNbGuid);
  };

  auto guideRank = [&](const int theGuideIdx) {
    double aSum = 0.0;
    for (int aProfileIdx = 1; aProfileIdx <= aNbProf; ++aProfileIdx)
    {
      aSum += theProfileParams(aProfileIdx, theGuideIdx);
    }
    return aSum / static_cast<double>(aNbProf);
  };

  NCollection_LinearVector<int> aProfileOrder;
  NCollection_LinearVector<int> aGuideOrder;
  for (size_t aProfileIdx = 0; aProfileIdx < static_cast<size_t>(aNbProf); ++aProfileIdx)
  {
    aProfileOrder.Append(static_cast<int>(aProfileIdx) + 1);
  }
  for (size_t aGuideIdx = 0; aGuideIdx < static_cast<size_t>(aNbGuid); ++aGuideIdx)
  {
    aGuideOrder.Append(static_cast<int>(aGuideIdx) + 1);
  }

  std::sort(aProfileOrder.begin(), aProfileOrder.end(), [&](int theLeft, int theRight) {
    return profileRank(theLeft) < profileRank(theRight);
  });
  std::sort(aGuideOrder.begin(), aGuideOrder.end(), [&](int theLeft, int theRight) {
    return guideRank(theLeft) < guideRank(theRight);
  });

  for (size_t aTargetIdx = 0; aTargetIdx < aProfileOrder.Size(); ++aTargetIdx)
  {
    const int aTargetArrayIdx = static_cast<int>(aTargetIdx) + 1;
    const int aSourceIdx      = aProfileOrder.Value(aTargetIdx);
    swapProfiles(aTargetArrayIdx, aSourceIdx);
    for (size_t aQueuedIdx = 0; aQueuedIdx < aProfileOrder.Size(); ++aQueuedIdx)
    {
      int& aQueuedArrayIdx = aProfileOrder.ChangeValue(aQueuedIdx);
      if (aQueuedArrayIdx == aTargetArrayIdx)
      {
        aQueuedArrayIdx = aSourceIdx;
      }
      else if (aQueuedArrayIdx == aSourceIdx)
      {
        aQueuedArrayIdx = aTargetArrayIdx;
      }
    }
  }

  for (size_t aTargetIdx = 0; aTargetIdx < aGuideOrder.Size(); ++aTargetIdx)
  {
    const int aTargetArrayIdx = static_cast<int>(aTargetIdx) + 1;
    const int aSourceIdx      = aGuideOrder.Value(aTargetIdx);
    swapGuides(aTargetArrayIdx, aSourceIdx);
    for (size_t aQueuedIdx = 0; aQueuedIdx < aGuideOrder.Size(); ++aQueuedIdx)
    {
      int& aQueuedArrayIdx = aGuideOrder.ChangeValue(aQueuedIdx);
      if (aQueuedArrayIdx == aTargetArrayIdx)
      {
        aQueuedArrayIdx = aSourceIdx;
      }
      else if (aQueuedArrayIdx == aSourceIdx)
      {
        aQueuedArrayIdx = aTargetArrayIdx;
      }
    }
  }

  for (size_t aProfileIdx = 0; aProfileIdx < theProfiles.Size(); ++aProfileIdx)
  {
    const int aProfileArrayIdx = static_cast<int>(aProfileIdx) + 1;
    if (theProfileParams(aProfileArrayIdx, 1) > theProfileParams(aProfileArrayIdx, aNbGuid))
    {
      reverseProfile(aProfileArrayIdx);
    }
  }
  for (size_t aGuideIdx = 0; aGuideIdx < theGuides.Size(); ++aGuideIdx)
  {
    const int aGuideArrayIdx = static_cast<int>(aGuideIdx) + 1;
    if (theGuideParams(1, aGuideArrayIdx) > theGuideParams(aNbProf, aGuideArrayIdx))
    {
      reverseGuide(aGuideArrayIdx);
    }
  }

  return true;
}

//=================================================================================================

//! Reparametrizes all curves to shared averaged intersection parameters.
//! @return false if auxiliary interpolation or sampled curve interpolation fails
bool redistributeNetworkParameters(NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theProfiles,
                                   NCollection_Array1<occ::handle<Geom_BSplineCurve>>& theGuides,
                                   NCollection_Array2<double>& theProfileParams,
                                   NCollection_Array2<double>& theGuideParams,
                                   const double                theTolerance)
{
  const size_t aNbProf = theProfiles.Size();
  const size_t aNbGuid = theGuides.Size();

  NCollection_Array1<double> aAvgProfileParams(1, static_cast<int>(aNbGuid));
  for (size_t aGuideIdx = 0; aGuideIdx < aAvgProfileParams.Size(); ++aGuideIdx)
  {
    double aSum = 0.0;
    for (size_t aProfileIdx = 0; aProfileIdx < aNbProf; ++aProfileIdx)
    {
      aSum += theProfileParams.At(aProfileIdx, aGuideIdx);
    }
    aAvgProfileParams.ChangeAt(aGuideIdx) = aSum / static_cast<double>(aNbProf);
  }

  NCollection_Array1<double> aAvgGuideParams(1, static_cast<int>(aNbProf));
  for (size_t aProfileIdx = 0; aProfileIdx < aAvgGuideParams.Size(); ++aProfileIdx)
  {
    double aSum = 0.0;
    for (size_t aGuideIdx = 0; aGuideIdx < aNbGuid; ++aGuideIdx)
    {
      aSum += theGuideParams.At(aProfileIdx, aGuideIdx);
    }
    aAvgGuideParams.ChangeAt(aProfileIdx) = aSum / static_cast<double>(aNbGuid);
  }

  for (int aProfileIdx = 1; aProfileIdx <= static_cast<int>(aNbProf); ++aProfileIdx)
  {
    NCollection_Array1<double> anOldParams(1, static_cast<int>(aNbGuid));
    NCollection_Array1<double> aNewParams(1, static_cast<int>(aNbGuid));
    for (int aGuideIdx = 1; aGuideIdx <= static_cast<int>(aNbGuid); ++aGuideIdx)
    {
      anOldParams(aGuideIdx) = theProfileParams(aProfileIdx, aGuideIdx);
      aNewParams(aGuideIdx)  = aAvgProfileParams.At(static_cast<size_t>(aGuideIdx - 1));
    }

    if (!reparamCurve(theProfiles(aProfileIdx), anOldParams, aNewParams, theTolerance))
    {
      return false;
    }

    for (int aGuideIdx = 1; aGuideIdx <= static_cast<int>(aNbGuid); ++aGuideIdx)
    {
      theProfileParams(aProfileIdx, aGuideIdx) =
        aAvgProfileParams.At(static_cast<size_t>(aGuideIdx - 1));
    }
  }

  for (int aGuideIdx = 1; aGuideIdx <= static_cast<int>(aNbGuid); ++aGuideIdx)
  {
    NCollection_Array1<double> anOldParams(1, static_cast<int>(aNbProf));
    NCollection_Array1<double> aNewParams(1, static_cast<int>(aNbProf));
    for (int aProfileIdx = 1; aProfileIdx <= static_cast<int>(aNbProf); ++aProfileIdx)
    {
      anOldParams(aProfileIdx) = theGuideParams(aProfileIdx, aGuideIdx);
      aNewParams(aProfileIdx)  = aAvgGuideParams.At(static_cast<size_t>(aProfileIdx - 1));
    }

    if (!reparamCurve(theGuides(aGuideIdx), anOldParams, aNewParams, theTolerance))
    {
      return false;
    }

    for (int aProfileIdx = 1; aProfileIdx <= static_cast<int>(aNbProf); ++aProfileIdx)
    {
      theGuideParams(aProfileIdx, aGuideIdx) =
        aAvgGuideParams.At(static_cast<size_t>(aProfileIdx - 1));
    }
  }

  return true;
}

} // namespace GeomFill_GordonUtils

#endif // _GeomFill_GordonUtils_HeaderFile
