#ifndef _RWStepVisual_RWDraughtingModelAndTessellatedShapeRepresentation_HeaderFile
#define _RWStepVisual_RWDraughtingModelAndTessellatedShapeRepresentation_HeaderFile

#include <Standard.hxx>
#include <Standard_Handle.hxx>

class Interface_Check;
class Interface_EntityIterator;
class StepData_StepReaderData;
class StepData_StepWriter;
class StepVisual_DraughtingModelAndTessellatedShapeRepresentation;

//! Read and write DRAUGHTING_MODEL and TESSELLATED_SHAPE_REPRESENTATION.
//! All attributes belong to REPRESENTATION; the remaining components are empty.
class RWStepVisual_RWDraughtingModelAndTessellatedShapeRepresentation
{
public:
  //! Read representation attributes.
  //! @param[in] theData STEP records
  //! @param[in] theNumber complex entity record number
  //! @param[in,out] theCheck read diagnostics
  //! @param[out] theEntity representation to initialize
  Standard_HIDDEN void ReadStep(
    const occ::handle<StepData_StepReaderData>&                                     theData,
    int                                                                             theNumber,
    occ::handle<Interface_Check>&                                                   theCheck,
    const occ::handle<StepVisual_DraughtingModelAndTessellatedShapeRepresentation>& theEntity)
    const;

  //! Write the STEP complex entity.
  //! @param[in,out] theWriter STEP output
  //! @param[in] theEntity representation to write
  Standard_HIDDEN void WriteStep(
    StepData_StepWriter&                                                            theWriter,
    const occ::handle<StepVisual_DraughtingModelAndTessellatedShapeRepresentation>& theEntity)
    const;

  //! Visit representation items and their unit context.
  //! @param[in] theEntity representation to inspect
  //! @param[in,out] theIterator referenced entities
  Standard_HIDDEN void Share(
    const occ::handle<StepVisual_DraughtingModelAndTessellatedShapeRepresentation>& theEntity,
    Interface_EntityIterator& theIterator) const;
};

#endif // _RWStepVisual_RWDraughtingModelAndTessellatedShapeRepresentation_HeaderFile
